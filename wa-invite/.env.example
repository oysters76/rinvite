# Copy to .env and fill in. Nothing is ever prompted for interactively —
# a missing required value aborts the command.

# --- rinvite API ---
RINVITE_API_BASE_URL=https://api.rinvite.link
# JWT from POST /auth/login. Expires after 24h.
RINVITE_TOKEN=
# Used only when RINVITE_TOKEN is blank, so the 24h expiry doesn't force a re-paste.
RINVITE_EMAIL=
RINVITE_PASSWORD=

# --- invite link ---
# Optional. When set, the host of every invite_url returned by the API is
# rewritten to this origin; the /i/{token} path is preserved byte-for-byte.
# Leave blank to use the links exactly as the server built them.
INVITE_BASE_URL=

# --- WhatsApp ---
WA_SESSION_DB=./session/wa.db
# Prefix applied to bare or leading-zero numbers. 94 = Sri Lanka.
WA_DEFAULT_COUNTRY_CODE=94
WA_DELAY_SECONDS=8
WA_JITTER_SECONDS=4
WA_BATCH_SIZE=25
WA_BATCH_PAUSE_SECONDS=120

# --- message ---
WA_TEMPLATE_FILE=./templates/whatsapp.txt
WA_LEDGER_DB=./ledger.db
